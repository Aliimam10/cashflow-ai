# CashFlow AI environment configuration
#
# Copy this file to .env for local overrides. Commit only safe example values.
# Never place credentials or personal financial data in this file.
CASHFLOW_ENVIRONMENT=development
CASHFLOW_DEBUG=true
CASHFLOW_LOG_LEVEL=DEBUG
CASHFLOW_LOG_FORMAT=console
CASHFLOW_TIMEZONE=UTC
CASHFLOW_DATABASE_URL=sqlite:///data/cashflow.db
CASHFLOW_API_HOST=127.0.0.1
CASHFLOW_API_PORT=8000
CASHFLOW_UI_HOST=127.0.0.1
CASHFLOW_UI_PORT=8501
